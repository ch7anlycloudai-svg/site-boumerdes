# Environment Variables
# Copy this file to .env and update the values

# Server port (Hostinger will set this automatically, usually 3000)
PORT=3000

# Environment (set to 'production' on Hostinger)
NODE_ENV=production

# Session secret (IMPORTANT: Change this to a random string!)
# Generate one at: https://randomkeygen.com/ (use 256-bit WEP Keys)
SESSION_SECRET=your-super-secret-key-change-in-production

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database password (required for auto-creating tables on first deploy)
# Find it in: Supabase Dashboard > Settings > Database > Connection string > Password
SUPABASE_DB_PASSWORD=your-database-password-here
# Or provide the full connection string directly:
# SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional: Allowed origins for CORS (comma-separated)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
